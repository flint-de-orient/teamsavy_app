<?xml version="1.0" encoding="utf-8"?>
<!-- Launch splash: the brand ink (CSS brand-panel) with the TeamSavy mark,
     matching the in-app SplashScreen that follows it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_ink" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/ic_launcher_foreground" />
    </item>
</layer-list>
